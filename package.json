{
  "name": "llamacpp-gui",
  "private": true,
  "version": "0.3.11",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "stamp:version": "node scripts/stamp-version.mjs",
    "cargo:proxy": "node scripts/cargo-proxy.mjs",
    "test:web": "tsc --noEmit",
    "test:rs": "cargo test --lib --manifest-path src-tauri/Cargo.toml",
    "test:smoke": "node scripts/smoke-paramform.mjs",
    "lint": "eslint src",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "test": "npm run test:web && npm run test:rs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "html2canvas": "^1.4.1",
    "jszip": "^3.10.2",
    "pdfjs-dist": "^6.5.438",
    "react": "^19",
    "react-dom": "^19",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.10.1",
    "typescript": "~5.9",
    "typescript-eslint": "^8.72.2",
    "vite": "^7"
  }
}
